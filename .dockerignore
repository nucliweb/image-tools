# Keep the build context lean and the image reproducible.

# Version control and CI metadata
.git
.gitignore
.dockerignore
.github

# Local-only material, never part of the image
harness-proyecto/

# Non-reproducible / heavy demo inputs (fetched via compare/demos/fetch.sh)
compare/demos/images/

# Work artifacts and generated output
**/*.log
scratch/
tmp/
out/
.DS_Store
